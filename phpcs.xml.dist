<?xml version="1.0"?>
<ruleset name="Kadenz Slider" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/squizlabs/PHP_CodeSniffer/master/phpcs.xsd">
	<description>Coding standards for Kadenz Slider.</description>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="ps"/>
	<arg name="basepath" value="."/>
	<arg name="parallel" value="8"/>

	<file>kadenz-slider.php</file>
	<file>includes</file>
	<file>src</file>
	<file>tests/php</file>

	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>

	<rule ref="WordPress"/>

	<config name="testVersion" value="7.4-"/>
	<rule ref="PHPCompatibilityWP"/>

	<config name="minimum_wp_version" value="6.6"/>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="kadenz_slider"/>
				<element value="Kadenz\Slider"/>
				<element value="KADENZ_SLIDER"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="kadenz-slider"/>
			</property>
		</properties>
	</rule>

	<!-- Test classes use PSR-4-like file names. -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>tests/php/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude-pattern>tests/php/*/bootstrap.php</exclude-pattern>
	</rule>
</ruleset>
