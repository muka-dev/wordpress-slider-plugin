{
	"name": "kadenz-slider",
	"version": "0.1.0",
	"description": "Ad-free, accessible, block-native slider for WordPress.",
	"author": "Kadenz",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"wordpress",
		"block",
		"slider",
		"carousel",
		"accessibility"
	],
	"homepage": "https://github.com/muka-dev/wordpress-slider-plugin",
	"repository": {
		"type": "git",
		"url": "https://github.com/muka-dev/wordpress-slider-plugin.git"
	},
	"bugs": {
		"url": "https://github.com/muka-dev/wordpress-slider-plugin/issues"
	},
	"private": true,
	"files": [
		"kadenz-slider.php",
		"includes",
		"build",
		"languages",
		"readme.txt",
		"LICENSE"
	],
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@playwright/test": "^1.65.1",
		"@size-limit/file": "^14.3.0",
		"@wordpress/e2e-test-utils-playwright": "^1.54.0",
		"@wordpress/env": "^10.0.0",
		"@wordpress/scripts": "^30.0.0",
		"size-limit": "^14.3.0",
		"typescript": "~7.0.2"
	},
	"scripts": {
		"build": "wp-scripts build --experimental-modules",
		"start": "wp-scripts start --experimental-modules",
		"lint": "npm run lint:js && npm run lint:css && npm run lint:pkg",
		"lint:js": "wp-scripts lint-js src tests --no-error-on-unmatched-pattern",
		"lint:css": "wp-scripts lint-style \"src/**/*.scss\"",
		"lint:pkg": "wp-scripts lint-pkg-json",
		"format": "wp-scripts format",
		"plugin-zip": "wp-scripts plugin-zip",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"test:js": "wp-scripts test-unit-js tests/js",
		"test:e2e": "wp-scripts test-playwright --trace off",
		"size": "size-limit",
		"test:php": "wp-env run tests-cli --env-cwd=wp-content/plugins/kadenz-slider vendor/bin/phpunit --bootstrap tests/php/integration/bootstrap.php --testsuite integration"
	}
}
