{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "kadenz/slider",
	"title": "Slider",
	"category": "media",
	"description": "An accessible slider that contains slides.",
	"textdomain": "kadenz-slider",
	"allowedBlocks": [ "kadenz/slide" ],
	"attributes": {
		"label": { "type": "string", "default": "" },
		"effect": { "type": "string", "default": "slide" },
		"perView": {
			"type": "object",
			"default": { "base": 1, "md": 1, "lg": 1 }
		},
		"gap": { "type": "string", "default": "1.5rem" },
		"peek": { "type": "string", "default": "0px" },
		"heightMode": { "type": "string", "default": "aspect" },
		"aspectRatio": { "type": "string", "default": "16/9" },
		"minHeight": { "type": "string", "default": "" },
		"autoplay": { "type": "boolean", "default": false },
		"interval": { "type": "number", "default": 6000 },
		"pauseOnHover": { "type": "boolean", "default": true },
		"endBehavior": { "type": "string", "default": "stop" },
		"showArrows": { "type": "boolean", "default": true },
		"pagination": { "type": "string", "default": "dots" },
		"controlsPosition": { "type": "string", "default": "overlay" }
	},
	"supports": {
		"align": [ "wide", "full" ],
		"html": false,
		"color": { "background": true, "text": true },
		"spacing": { "margin": true, "padding": true },
		"shadow": true,
		"interactivity": true
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScriptModule": "file:./view.js",
	"render": "file:./render.php"
}
